# Copy to .env and fill in. Never commit the real .env.
TRACKER_PROVIDER=mock            # mock | samsara | gtfs_rt | transloc
SAMSARA_API_TOKEN=               # from NSU's Samsara admin; scope: Read Vehicle Statistics only
SAMSARA_TAG_IDS=                 # optional: tag that groups the shuttles
SAMSARA_VEHICLE_ROUTE_MAP={}     # e.g. {"Shuttle 1": "campus-loop"}
SAMSARA_DEFAULT_ROUTE=
TRANSLOC_API_KEY=
TRANSLOC_AGENCY_ID=
GTFS_RT_URL=                     # vendor's GTFS-Realtime VehiclePositions URL
GTFS_RT_API_KEY=
GTFS_RT_API_KEY_HEADER=x-api-key
GTFS_RT_ROUTE_MAP={}             # e.g. {"4012345": "campus-loop"}
JWT_SECRET=change-me-long-random-string
PASS_SECRET=change-me-another-long-random-string
ALLOWED_EMAIL_DOMAINS=spartans.nsu.edu,nsu.edu
PASS_WINDOW_SECONDS=30
DATABASE_PATH=spartango.db
