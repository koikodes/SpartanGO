{
  "expo": {
    "name": "SpartanGO",
    "slug": "spartango",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.nsu.spartango"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#007A53",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "edu.nsu.spartango"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "spartango",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "SpartanGO uses the camera so drivers can scan student ride passes."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#007A53"
        }
      ]
    ]
  }
}
